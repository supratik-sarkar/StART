# Copy to .env and fill in only what you use. Never commit .env.
#
# StART runs completely without any of these. With none set, the agent layer
# uses its deterministic path and still produces a full, sealed review.

# ─── Runtime profile ────────────────────────────────────────────────────────
# public_demo  third-party SaaS inference permitted (default on a laptop)
# enterprise   only the operator-supplied gateway; public providers refused
# airgapped    no outbound inference at all
#
# Leave unset and StART infers it: configuring a gateway, or installing a
# package that registers one, implies `enterprise`.
# START_PROFILE=public_demo

# ─── Public providers (public_demo profile) ─────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
HF_TOKEN=

# ─── Operator-supplied gateway (enterprise profile) ─────────────────────────
# For any gateway that speaks the OpenAI chat-completions format, these three
# are sufficient and no code changes are required.
#
# Note START_GATEWAY_API_KEY_ENV holds the NAME of the variable carrying the
# token, not the token. Your credential naming convention is an internal detail
# and does not belong in a committed file.
#
# START_GATEWAY_BASE_URL=https://<host>/<path>/v1
# START_GATEWAY_API_KEY_ENV=MY_ORG_TOKEN
# START_GATEWAY_MODEL=<model name>
# START_GATEWAY_EXTRA_HEADERS={"X-Request-Source":"start-mrt"}
# START_GATEWAY_TIMEOUT=60
#
# For a gateway that is NOT OpenAI-compatible, ship a private wheel exposing a
# `start.llm_gateways` entry point instead. See docs/enterprise_integration.md.

# ─── Optional config overrides (prefix START_, nested via __) ───────────────
# START_LLM__PROVIDER=gateway
# START_COMPUTE__DEVICE=mps
# START_EXPERIMENT__PROVIDER=mlflow

# ─── Local-only test helper ─────────────────────────────────────────────────
# tests/test_enterprise_adapter.py scans the repository for a forbidden
# organisation name. Set it here in your LOCAL .env only — never committed.
# START_FORBIDDEN_ORG_TOKEN=
